{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker:postgres",
      "type": "shell",
      "command": "docker compose up -d --wait postgres",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "dev:prep",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/kill-dev-ports.ps1",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "db:studio",
      "type": "shell",
      "command": "npm run db:studio",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "server:dev",
      "type": "shell",
      "command": "npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "client:dev",
      "type": "shell",
      "command": "npm run dev:only",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "dev:apps",
      "dependsOn": ["db:studio", "server:dev", "client:dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "dev:infra",
      "dependsOn": ["docker:postgres", "dev:prep"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "dev:all",
      "dependsOn": ["dev:infra", "dev:apps"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
