  "exchange_events": [
    {
      "id": "ex_ch2_first_meet",
      "enabled": true,
      "chapter": "ch2_unease",
      "require_flags": [
        "met_hook"
      ],
      "speakers": [
        "npc_suolunsen",
        "npc_hilvi"
      ],
      "beat_hints": [
        "【语气】压低、试探。必触及：转校传闻或走廊/钟表不对劲。禁说：虚假、模拟、游戏、存档、结局、地震、死亡。禁止总结剧情、禁止对玩家说话、禁止自称 AI。只说1～2句口语。",
        "【语气】礼貌疏离，短句。必触及：对传闻轻描淡写或反问一句。禁说：点破世界真相、剧透未发生事件。禁止总结、禁止自称 AI、禁止对玩家告白式长篇。只说1～2句。"
      ],
      "fallback_lines": [
        "希尔薇……你也听到走廊那边的钟不对劲了？",
        "只是转校手续而已。别太紧张。"
      ],
      "set_flags": [
        {
          "name": "ex_ch2_meet_done",
          "value": "true"
        }
      ],
      "once": true,
      "notes": "升入裂痕且已听闻希尔薇后，首次旁听互聊（演示必触发点）"
    },
    {
      "id": "ex_ch2_after_trust",
      "enabled": true,
      "chapter": "ch2_unease",
      "require_flags": [
        "path_trust"
      ],
      "speakers": [
        "npc_hilvi",
        "npc_suolunsen"
      ],
      "beat_hints": [
        "【语气】轻、克制。必触及：愿意一起查，但不激动。禁说：地震、死亡、结局、游戏、存档。禁止对玩家说话。1～2句。",
        "【语气】认真、压住兴奋。必触及：下一步从哪查（校志/图书馆等日常地点）。禁说：元叙事、宣布升章。禁止总结。1～2句。"
      ],
      "fallback_lines": [
        "……如果你们愿意查，我可以帮忙找资料。",
        "那从缺页的校志开始。别声张。"
      ],
      "set_flags": [
        {
          "name": "ex_ch2_trust_done",
          "value": "true"
        }
      ],
      "once": true,
      "notes": "玩家表态相信后，两人短暂互聊（可选第二条演示）"
    }
  ]
