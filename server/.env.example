# Server port (HTTP + WebSocket)
# 若 Windows 报 EACCES listen 0.0.0.0:4000：多半是 Hyper-V 排除端口（常见 3954–4353），改用 4400 等未占用端口，并同步 client NEXT_PUBLIC_GAME_SERVER_URL
PORT=4400

# Frontend origin for CORS（本机 npm 开发默认 3300；Docker 全栈同样是 3300）
CLIENT_ORIGIN=http://localhost:3300

# PostgreSQL
# 本机开发（DB 在 Docker，端口映射 15432）：
DATABASE_URL=postgresql://ocraft:ocraft@localhost:15432/ocraft
# Docker 全栈时由 compose 覆盖为：postgresql://ocraft:ocraft@postgres:5432/ocraft

# Story Pack（可选；默认仓库根目录 story-packs/ + office 默认版）
# STORY_PACKS_ROOT=D:/OCraft/ocraft-ai-game/story-packs
# OFFICIAL_WORLD=office
# OFFICIAL_VERSION_DIR=official-mvp__20260710T1045

# 登录 token 签名密钥（生产环境务必改成随机长字符串）
AUTH_SECRET=change-me-in-production

# 大模型 Api 配置（Docker 全栈会通过 env_file 读入 server/.env）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=xxx
LLM_MODEL=xxx

# Mem-V 向量嵌入模型（可选；省略则用 text-embedding-v3；无 key 时走本地袋向量）
# LLM_EMBED_MODEL=text-embedding-v3

# 导演 Agent 专用模型（可选；省略则复用 LLM_MODEL）
# DIRECTOR_MODEL=qwen-plus

# Kimi example:
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
