# Server port (HTTP + WebSocket)
# 若 Windows 报 EACCES listen 0.0.0.0:4000：多半是 Hyper-V 排除端口（常见 3954–4353），改用 4400 等未占用端口，并同步 client NEXT_PUBLIC_GAME_SERVER_URL
PORT=4400

# Frontend origin for CORS（本机 npm 开发默认 3300；Docker 全栈同样是 3300）
# 生产请改成你的站点，可逗号分隔多值，例如：
# CLIENT_ORIGIN=https://cspona.top,https://www.cspona.top
CLIENT_ORIGIN=http://localhost:3300

# PostgreSQL
# 本机开发（DB 在 Docker，端口映射 15432）：
DATABASE_URL=postgresql://ocraft:ocraft@localhost:15432/ocraft
# Docker 全栈时由 compose 覆盖为：postgresql://ocraft:ocraft@postgres:5432/ocraft

# Story Pack（可选；默认仓库根目录 story-packs/ + office 默认版）
# STORY_PACKS_ROOT=/absolute/path/to/story-packs
# OFFICIAL_WORLD=office
# OFFICIAL_VERSION_DIR=official-mvp__20260710T1045

# 登录 token 签名密钥【必填】。
# 为空、缺失、或仍是 change-me-in-production 之类的占位符时，服务会直接拒绝启动。
# 原因：密钥一旦公开可知，任何人都能离线伪造任意玩家的登录 token。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 监听地址【默认只监听本机】。
# 缺省 127.0.0.1：只有本机能访问，同局域网 / 公共 WiFi / Radmin VPN 等
# 虚拟局域网上的其他设备都连不上。确实需要别的设备访问时再改成 0.0.0.0，
# 并同时配置下面的 PACK_ADMIN_IDS 并收紧系统防火墙。
# BIND_HOST=127.0.0.1

# 剧情包写操作 / AI 生成接口的管理员白名单（playerId，逗号分隔，如 001,002）。
# 仅在 BIND_HOST 指向外部地址时才必须配置，否则这些接口一律拒绝。
# 原因：覆写或删除一个版本会连带清掉该版本下所有玩家的进度与人设；
# AI 生成类接口则直接消耗服务端的模型额度。不能让任何注册用户都能调用。
# PACK_ADMIN_IDS=001

# 大模型 Api 配置（Docker 全栈会通过 env_file 读入 server/.env）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=xxx
LLM_MODEL=xxx
# 是否允许用上面的 LLM_* 顶替「玩家未在设置里填的 Key」。
# 默认：development=允许（本机方便）；production=不允许（玩家必须自备 Key）。
# 公网部署请保持 false / 不设，并最好不要在服务器 .env 放可用的付费 Key。
# LLM_ALLOW_ENV_FALLBACK=false
# Qwen3.5/3.7 hybrid 默认会开深度思考，对话极慢；游戏默认关。真要思考再设 true
# LLM_ENABLE_THINKING=false 默认关

# LM Studio 本地（本机 Ctrl+Shift+B；详见 Docs/Agent/本地部署.md）
# LLM_API_KEY=lmstudio
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen3-8b-instruct
# Docker 全栈连宿主机 LM Studio 时改用：
# LLM_BASE_URL=http://host.docker.internal:1234/v1

# Mem-V 向量嵌入模型（可选；省略则用 text-embedding-v3；无 key 时走本地袋向量）
# LLM_EMBED_MODEL=text-embedding-v3

# 导演 Agent 专用模型（可选；省略则复用 LLM_MODEL）
# DIRECTOR_MODEL=qwen-plus

# Kimi example:
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
