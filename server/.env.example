# Server port (HTTP + WebSocket)
PORT=3010

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL (Phase B player persistence)
DATABASE_URL=postgresql://ocraft:ocraft@localhost:5432/ocraft

# --- Real LLM mode (leave blank for MOCK mode) ---
# 自动加载：.env is loaded automatically on server startup (see src/main.ts).
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Kimi example:
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
