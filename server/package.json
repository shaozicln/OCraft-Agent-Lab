{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build --prefix ../packages/shared && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "pack:validate": "ts-node -r tsconfig-paths/register scripts/validate-pack.ts",
    "pack:seed": "ts-node -r tsconfig-paths/register scripts/seed-pack.ts",
    "pack:save": "ts-node -r tsconfig-paths/register scripts/save-pack.ts",
    "pack:eval": "ts-node -r tsconfig-paths/register scripts/eval-pack.ts",
    "pack:eval:all": "ts-node -r tsconfig-paths/register scripts/eval-pack.ts -- --all",
    "tools:eval": "ts-node -r tsconfig-paths/register scripts/eval-strong-tools.ts",
    "director:eval": "ts-node -r tsconfig-paths/register scripts/eval-director-hint.ts",
    "rag:eval": "ts-node -r tsconfig-paths/register scripts/eval-rag.ts",
    "multiagent:eval": "ts-node -r tsconfig-paths/register scripts/eval-multiagent.ts",
    "clarify:eval": "ts-node -r tsconfig-paths/register scripts/eval-clarify.ts",
    "distill:eval": "ts-node -r tsconfig-paths/register scripts/eval-distill.ts",
    "safety:eval": "ts-node -r tsconfig-paths/register scripts/eval-safety.ts",
    "autoplay:eval": "ts-node -r tsconfig-paths/register scripts/eval-autoplay.ts",
    "voice:eval": "ts-node -r tsconfig-paths/register scripts/eval-pack-voice.ts",
    "ending:eval": "ts-node -r tsconfig-paths/register scripts/eval-ending.ts",
    "lab:eval": "ts-node -r tsconfig-paths/register scripts/eval-lab.ts",
    "notes:eval": "ts-node -r tsconfig-paths/register scripts/eval-player-notes.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/websockets": "^11.1.24",
    "@ocraft/shared": "file:../packages/shared",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "ocraft-ai-game": "file:..",
    "openai": "^6.42.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
